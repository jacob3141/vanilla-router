# Web interface (M4). Runs without root, only with CAP_NET_BIND_SERVICE (ports 443/80). Everything
# privileged goes through vr-webui-helper (D-04). Ping runs natively, without programs with file
# capabilities, which the hardening would prevent (L-09).
[Unit]
Description=vanilla-router web interface
After=network.target vr-webui-helper.service
Wants=vr-webui-helper.service
ConditionPathExists=/etc/vanilla-router/config.json

[Service]
Type=simple
User=vr-webui
Group=vr-webui
# "+": as root before the start (TLS certificate, setup code from the installer)
ExecStartPre=+/usr/sbin/vr-webui prepare
ExecStart=/usr/sbin/vr-webui serve
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/vanilla-router/webui
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
