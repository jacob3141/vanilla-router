# Generated by vanilla-router, do not edit by hand.
# Make changes through the web interface or /etc/vanilla-router/config.json and `vrctl apply`.

[Match]
Name=ppp0

[Link]
RequiredForOnline=no

[Network]
KeepConfiguration=yes
DHCP=ipv6
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[DHCPv6]
PrefixDelegationHint=::/56
UseDNS=yes
WithoutRA=solicit

[IPv6AcceptRA]
UseDNS=yes
