# Privileged helper of the web interface: fixed list of actions, only for the user vr-webui
# (SO_PEERCRED). Changes the configuration only through config.json and vrctl-apply logic.
[Unit]
Description=vanilla-router web interface (helper)
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/vr-webui helper
RuntimeDirectory=vr-webui
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
