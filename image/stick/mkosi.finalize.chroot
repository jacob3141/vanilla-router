#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Runs after mkosi's presets, which would otherwise turn all the package's services back on.
set -e
# Fail the build, not the user's installation, if the installer lacks a tool (internal/install).
for tool in blkid btrfs chroot mkfs.btrfs mkfs.vfat mount sfdisk sync systemctl tar udevadm umount wipefs zstd; do
	command -v "$tool" >/dev/null || { echo "stick image lacks $tool" >&2; exit 1; }
done
# Only the firmware of network cards stays, the rest is most of the image's size.
# The stick needs nothing else, the router restores it with vrctl complete (D-17).
if [ -d /usr/lib/firmware ]; then
	find /usr/lib/firmware -mindepth 1 -maxdepth 1 \
		! -name rtl_nic ! -name intel ! -name bnx2 ! -name bnx2x ! -name tigon -exec rm -rf {} +
fi
# With an empty machine-id, systemd treats every start as the first boot and tries to apply presets on
# the read-only stick, which fills the console with errors.
tr -d - </proc/sys/kernel/random/uuid >/etc/machine-id
systemctl enable vr-installer.service
systemctl mask getty@tty1.service
# No network services should run on the stick: the assistant turns the ports on itself.
for unit in systemd-networkd.service systemd-networkd.socket ssh.service ssh.socket \
	vr-firewall.service vr-firewall-reload.timer vr-dnsmasq.service vr-pppoe.service \
	vr-webui.service vr-webui-helper.service vr-apd.service vr-health.service \
	vr-smbd.service vr-webui-files.service; do
	systemctl disable "$unit" 2>/dev/null || true
done
