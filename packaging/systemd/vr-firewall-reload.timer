# SPDX-License-Identifier: AGPL-3.0-or-later
# nft converts time-based blocks to UTC when loading. Reload daily, so the switch
# between summer and winter time is right (experience from the prototype).
[Unit]
Description=vanilla-router reload firewall daily (time-based blocks, daylight saving)

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
