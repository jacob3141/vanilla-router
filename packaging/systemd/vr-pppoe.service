# PPPoE dial-up (pppd with the rp-pppoe plugin). vrctl generates the configuration /etc/ppp/peers/vr-wan.
[Unit]
Description=vanilla-router internet dial-up (PPPoE)
After=systemd-networkd.service vr-firewall.service
Wants=systemd-networkd.service
ConditionPathExists=/etc/ppp/peers/vr-wan

[Service]
Type=simple
ExecStart=/usr/sbin/pppd call vr-wan nodetach
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
