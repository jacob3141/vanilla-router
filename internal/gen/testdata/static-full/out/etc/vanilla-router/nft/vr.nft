#!/usr/sbin/nft -f
# Generated by vanilla-router, do not edit by hand.
# Make changes through the web interface or /etc/vanilla-router/config.json and `vrctl apply`.

table inet vr_filter
delete table inet vr_filter

table inet vr_filter {
	set icmpv6_errors {
		type icmpv6_type
		elements = { destination-unreachable, packet-too-big, time-exceeded, parameter-problem }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		iifname "lan0" accept comment "home network may do anything"

		# ICMPv6 per RFC 4890: without ND, RA, MLD and PMTU, IPv6 does not work
		icmpv6 type @icmpv6_errors accept
		icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept
		icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } ip6 saddr fe80::/10 accept
		icmpv6 type echo-request limit rate 10/second accept
		icmp type echo-request limit rate 10/second accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iifname "lan0" oifname "wan0" accept comment "home network to internet"
		iifname "wan0" oifname "lan0" meta nfproto ipv4 ct status dnat accept comment "port forwards (DNAT in vr_portfw)"
		icmpv6 type @icmpv6_errors accept
		icmpv6 type echo-request iifname "wan0" oifname "lan0" limit rate 10/second accept
	}
}

table ip vr_nat
delete table ip vr_nat

table ip vr_nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wan0" masquerade
	}
}

table ip vr_portfw
delete table ip vr_portfw

table ip vr_portfw {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "wan0" tcp dport 8443 dnat to 192.168.42.21:443 comment "forward NAS"
		iifname "wan0" tcp dport 27000-27010 dnat to 192.168.42.20 comment "forward Spiel"
		iifname "wan0" udp dport 27000-27010 dnat to 192.168.42.20 comment "forward Spiel"
	}
}

table inet vr_block
delete table inet vr_block

table inet vr_block {
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "lan0" oifname "wan0" ether saddr 02:00:00:00:00:20 drop comment "block 02:00:00:00:00:20"
		iifname "lan0" oifname "wan0" ether saddr 02:00:00:00:00:21 meta hour "21:30"-"23:59:59" meta day { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday" } drop comment "block 02:00:00:00:00:21"
		iifname "lan0" oifname "wan0" ether saddr 02:00:00:00:00:21 meta hour "00:00"-"07:00" meta day { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" } drop comment "block 02:00:00:00:00:21"
	}
}
