# Von vanilla-router erzeugt, nicht von Hand ändern.
# Änderungen über die Weboberfläche oder /etc/vanilla-router/config.json und `vrctl apply`.

[Match]
Name=lan0

[Link]
RequiredForOnline=no

[Network]
Address=192.168.42.1/24
Address=fd12:3456:789a:1::1/64
ConfigureWithoutCarrier=yes
IPv6AcceptRA=no
LinkLocalAddressing=ipv6
IPv6SendRA=yes
DHCPPrefixDelegation=yes

[DHCPPrefixDelegation]
UplinkInterface=ppp0
SubnetId=1
Announce=yes

[IPv6SendRA]
EmitDNS=yes
DNS=fd12:3456:789a:1::1
EmitDomains=yes
Domains=home.arpa

[IPv6Prefix]
Prefix=fd12:3456:789a:1::/64
