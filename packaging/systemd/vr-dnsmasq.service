# DNS und DHCPv4 im Heimnetz. Startet das Programm aus dnsmasq-base (Ubuntu main), nicht das
# Paket dnsmasq aus universe (D-10). Konfiguration erzeugt vrctl.
[Unit]
Description=vanilla-router DNS und DHCP (dnsmasq)
After=network.target systemd-networkd.service
Wants=network.target
ConditionPathExists=/etc/vanilla-router/dnsmasq.conf

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/vanilla-router/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/vanilla-router/dnsmasq.conf --user=dnsmasq --group=nogroup --pid-file=
Restart=on-failure
RestartSec=2

# Härtung: dnsmasq braucht Port 53/67 und Rohsockets für DHCP, sonst nichts.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vanilla-router
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
