# Startet den Assistenten auf tty1 statt einer Anmeldung (PLAN.md 3.9.1).
[Unit]
Description=vanilla-router Installations-Assistent
After=systemd-user-sessions.service systemd-udev-settle.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/sbin/vr-install
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux
# Nach Abbruch neu starten, damit Laien nie vor einer Anmeldung stehen
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
