# Health check after every start (M5). Confirms the start for GRUB or restarts if the
# home network is not running after 10 minutes; GRUB then picks the state before the last update.
[Unit]
Description=vanilla-router health check after start
After=multi-user.target vr-dnsmasq.service vr-firewall.service systemd-networkd.service
Wants=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/vrctl health --mark-good --timeout 10m --reboot-on-fail
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
