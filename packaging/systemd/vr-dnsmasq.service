# DNS and DHCPv4 in the home network. Starts the program from dnsmasq-base (Ubuntu main), not the
# package dnsmasq from universe (D-10). vrctl generates the configuration.
[Unit]
Description=vanilla-router DNS and DHCP (dnsmasq)
After=network.target systemd-networkd.service
Wants=network.target
ConditionPathExists=/etc/vanilla-router/dnsmasq.conf

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/vanilla-router/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/vanilla-router/dnsmasq.conf --user=dnsmasq --group=nogroup --pid-file=
Restart=on-failure
RestartSec=2

# Hardening: dnsmasq needs ports 53/67 and raw sockets for DHCP, nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vanilla-router
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
