# Starts the assistant on tty1 instead of a login (PLAN.md 3.9.1).
[Unit]
Description=vanilla-router installation assistant
After=systemd-user-sessions.service systemd-udev-settle.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/sbin/vr-install
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux
# Restart after an abort, so that non-experts never face a login prompt
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
