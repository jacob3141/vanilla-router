# Smart Home (docs/smarthome-concept.md): finds and reads devices in the home network. No root, no port of its own, only a
# socket for the web server. If it fails, the router does not notice.
[Unit]
Description=vanilla-router Smart Home
After=network.target
ConditionPathExists=/etc/vanilla-router/config.json

[Service]
Type=simple
User=vr-home
Group=vr-home
SupplementaryGroups=vr-webui
ExecStart=/usr/sbin/vr-webui home
Restart=on-failure
RestartSec=5
RuntimeDirectory=vr-home
RuntimeDirectoryMode=0755
StateDirectory=vanilla-router/home
StateDirectoryMode=0700

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Only the home network, no way to the internet
RestrictNetworkInterfaces=lan0
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
